#!/bin/sh
# 기기에서 도는 soak sampler. (A5 · A6, Core PRD §51 Android Soak Test)
#
#   nimwake-soak INTERVAL_SECONDS HOURS   새로 시작 — 끝 시각과 간격을 run/soak.active에 남긴다
#   nimwake-soak --resume                 run/soak.active의 끝 시각까지 이어서 돈다 (부팅 때 20-soak가 부른다)
#
# 재부팅으로 sampler가 죽어도 soak.active가 남아 있으면 Termux:Boot가 이어서 돌린다. 재부팅 동안의
# 공백은 soak.csv의 표본 간격(max gap)으로 드러난다. soak.active는 끝 시각에 닿거나 soak.sh stop일 때만 지운다.
#
# INTERVAL마다 한 줄을 ~/.nimwake-host/logs/soak.csv에 붙인다. 개발 머신이 꺼져 있어도 돈다.
# 요청은 echo app 하나에 보낸다. idle timeout(5s)보다 간격이 훨씬 길어 매 표본이 cold start → sleep 한 바퀴다.
#
# 측정할 수 없는 값은 NA로 남긴다 (기기마다 /sys 접근이 다르다).
#   apps_before  요청 직전에 떠 있던 application 수. scale-to-zero면 0이어야 한다 — 0이 아니면 잔존(orphan)
#   daemon_pid   바뀌면 supervisor가 재기동했다는 뜻이다
#   mem_avail_mb /proc/meminfo의 MemAvailable — Core --min-free-memory-mb 임계값을 정할 근거 (#42).
#                이 열이 없는 옛 soak.csv에 --resume으로 이어 쓸 때는 옛 형식(12열)을 지킨다
set -u

host="$HOME/.nimwake-host"
out="$host/logs/soak.csv"
tmp="$host/run/soak.body"
active="$host/run/soak.active"
gateway='http://127.0.0.1:8080/'

mkdir -p "$host/logs" "$host/run"

# 이미 도는 sampler가 있으면 하나만 둔다. pid만 보면 안 된다 — 재부팅 뒤에는 남은 pid 파일의 번호를
# 다른 process가 받았을 수 있고, 그러면 이어서 돌아야 할 soak이 "이미 도는 중"으로 멈춘다. 명령줄까지 본다.
running="$(cat "$host/run/soak.pid" 2>/dev/null || true)"
if [ -n "$running" ] && kill -0 "$running" 2>/dev/null &&
	ps -o args= -p "$running" 2>/dev/null | grep -q 'nimwake-soak'; then
	echo "nimwake-soak: already running (pid $running)" >&2
	exit 0
fi

if [ "${1:-}" = --resume ]; then
	[ -f "$active" ] || exit 0
	read -r end interval <"$active"
	if [ "$(date +%s)" -ge "$end" ]; then
		rm -f "$active"
		exit 0
	fi
else
	interval="${1:-300}"
	hours="${2:-24}"
	end=$(($(date +%s) + hours * 3600))
	echo "$end $interval" >"$active"
fi

echo "$$" >"$host/run/soak.pid"
trap 'rm -f "$host/run/soak.pid" "$tmp"' EXIT

if [ ! -f "$out" ]; then
	echo "epoch,time,http,seconds,app_pid,apps_before,daemon_pid,daemon_rss_kb,state,battery_pct,battery_temp_c,free_mb,mem_avail_mb" >"$out"
fi
# 한 파일 안에서 열 수가 섞이지 않게 한다
with_mem=0
head -n 1 "$out" | grep -q ',mem_avail_mb$' && with_mem=1

read_or_na() {
	cat "$1" 2>/dev/null || echo NA
}

# battery · temp를 채운다. Android는 앱에서 /sys/class/power_supply를 막는다 (SELinux — 2026-10-09 시운전에서 NA).
# Termux:API(같은 출처의 앱 + pkg termux-api)가 있으면 그것을 쓴다. 앱이 없으면 명령이
# 응답하지 않고 멈추므로 timeout을 건다. 둘 다 안 되면 NA.
battery_status() {
	battery=NA
	temp=NA
	if command -v termux-battery-status >/dev/null 2>&1; then
		_json="$(timeout 10 termux-battery-status 2>/dev/null | tr -d '\n ')"
		_pct="$(printf '%s' "$_json" | sed -n 's/.*"percentage":\([0-9][0-9]*\).*/\1/p')"
		_temp="$(printf '%s' "$_json" | sed -n 's/.*"temperature":\(-*[0-9][0-9.]*\).*/\1/p')"
		[ -n "$_pct" ] && battery="$_pct"
		[ -n "$_temp" ] && temp="$(awk -v t="$_temp" 'BEGIN { printf "%.1f", t }')"
	fi
	if [ "$battery" = NA ]; then
		battery="$(read_or_na /sys/class/power_supply/battery/capacity)"
	fi
	if [ "$temp" = NA ]; then
		_raw="$(read_or_na /sys/class/power_supply/battery/temp)"
		case "$_raw" in
		'' | NA | *[!0-9-]*) ;;
		*) temp="$(awk -v t="$_raw" 'BEGIN { printf "%.1f", t / 10 }')" ;;
		esac
	fi
}

# 테스트용: 표본 수를 제한한다 (0이면 시간으로만 끝난다)
samples_left="${NIMWAKE_SOAK_SAMPLES:-0}"

while [ "$(date +%s)" -lt "$end" ]; do
	apps_before="$(pgrep -f '^/opt/nimwake/bin/.*-server' 2>/dev/null | wc -l | tr -d ' ')"

	rm -f "$tmp"
	# 연결이 거부돼도 curl은 "-w"를 출력하고(000 0.0001) 실패 코드로 끝난다. 출력이 비었을 때만 채운다.
	result="$(curl -s -m 60 -o "$tmp" -w '%{http_code} %{time_total}' -H 'Host: echo.local' "$gateway" 2>/dev/null)"
	[ -n "$result" ] || result='000 NA'
	http="${result% *}"
	seconds="${result#* }"
	app_pid="$(tr -cd '0-9' <"$tmp" 2>/dev/null)"

	daemon_pid="$(pgrep -f '^/opt/nimwake/bin/nimwaked' 2>/dev/null | head -n 1)"
	daemon_rss=NA
	if [ -n "$daemon_pid" ]; then
		daemon_rss="$(awk '/^VmRSS:/ { print $2 }' "/proc/$daemon_pid/status" 2>/dev/null)"
	fi

	state="$(cut -d' ' -f1 "$host/run/state" 2>/dev/null)"
	battery_status

	free_mb=$(($(df -Pk "$HOME" | awk 'NR == 2 { print $4 }') / 1024))

	row="$(printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s' \
		"$(date +%s)" "$(date '+%Y-%m-%d %H:%M:%S')" "$http" "$seconds" "${app_pid:-NA}" \
		"$apps_before" "${daemon_pid:-NA}" "${daemon_rss:-NA}" "${state:-NA}" \
		"$battery" "$temp" "$free_mb")"
	if [ "$with_mem" = 1 ]; then
		mem="$(awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo 2>/dev/null)"
		row="$row,${mem:-NA}"
	fi
	echo "$row" >>"$out"

	if [ "$samples_left" -gt 0 ]; then
		samples_left=$((samples_left - 1))
		[ "$samples_left" -eq 0 ] && break
	fi
	sleep "$interval"
done

# 끝 시각에 닿았을 때만 soak이 끝난 것이다 (표본 수 제한으로 멈춘 테스트는 이어서 돌 수 있게 둔다)
if [ "$(date +%s)" -ge "$end" ]; then
	rm -f "$active"
fi
