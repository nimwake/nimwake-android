#!/bin/sh
# nimwake-host — Android Host Layer 진입점. (A2, PRD §33 최소판)
#
#   nimwake-host start      supervisor를 백그라운드로 띄운다 (이미 떠 있으면 그대로)
#   nimwake-host stop       nimwaked를 graceful하게 내리고 supervisor를 끝낸다
#   nimwake-host status     상태 · supervisor · nimwaked · health · 네트워크 · 남은 저장공간
#   nimwake-host logs [N]   supervisor.log와 nimwaked.log의 마지막 N줄 (기본 40)
#
# 기기에서는 make deploy가 ~/.nimwake-host/{bin,lib}에 설치하고 $PREFIX/bin에 링크한다.
#   NIMWAKE_HOST_LIB  lib 디렉터리 (기본 ~/.nimwake-host/lib). 테스트가 레포의 host/lib를 가리킨다
set -u

lib="${NIMWAKE_HOST_LIB:-$HOME/.nimwake-host/lib}"
# shellcheck source=../lib/config.sh
. "$lib/config.sh"
# shellcheck source=../lib/policy.sh
. "$lib/policy.sh"
# shellcheck source=../lib/supervisor.sh
. "$lib/supervisor.sh"
# shellcheck source=../lib/logs.sh
. "$lib/logs.sh"
# shellcheck source=../lib/network.sh
. "$lib/network.sh"
# shellcheck source=../lib/ingress.sh
. "$lib/ingress.sh"
# shellcheck source=../lib/battery.sh
. "$lib/battery.sh"

pid_file="$NIMWAKE_RUN/supervisor.pid"

supervisor_pid() {
	[ -f "$pid_file" ] || return 1
	_pid="$(cat "$pid_file")"
	# pid가 재사용됐을 수 있다. 우리 supervisor인지 명령줄로 확인한다.
	if kill -0 "$_pid" 2>/dev/null && ps -o args= -p "$_pid" 2>/dev/null | grep -q '__supervise'; then
		echo "$_pid"
		return 0
	fi
	return 1
}

cmd_start() {
	if _pid="$(supervisor_pid)"; then
		echo "nimwake-host: supervisor is already running (pid $_pid)"
		return 0
	fi
	if _daemon="$(daemon_pid)" && [ -n "$_daemon" ]; then
		echo "nimwake-host: nimwaked (pid $_daemon) is running without a supervisor — run nimwake-host stop first" >&2
		return 1
	fi
	# 이전 실행이 종료를 기록하지 못하고 사라졌는가 (재부팅 · Android가 Termux를 내림) — 상태를 지우기 전에 본다
	detect_unclean_end
	# 이전 실행의 RUNNING을 새 실행의 것으로 읽지 않게 상태를 비운다 (10-nimwake가 이것을 기다린다)
	rm -f "$NIMWAKE_RUN/stop" "$NIMWAKE_RUN/hung" "$NIMWAKE_RUN/state" "$NIMWAKE_RUN/heartbeat"
	nohup "$0" __supervise >/dev/null 2>&1 &
	echo "$!" >"$pid_file"
	echo "nimwake-host: supervisor started (pid $!)"
}

cmd_supervise() {
	echo "$$" >"$pid_file"
	trap 'rm -f "$pid_file"' EXIT
	trap '' HUP
	host_log "supervisor started (pid $$)"
	# ingress는 daemon과 따로 감시한다 — 어느 쪽이 죽어도 다른 쪽은 그대로 (host/lib/ingress.sh)
	_ingress_loop=""
	if ingress_enabled; then
		supervise_ingress &
		_ingress_loop=$!
	fi
	supervise
	_result=$?
	if [ -n "$_ingress_loop" ]; then
		ingress_stop
		wait "$_ingress_loop" 2>/dev/null || true
	fi
	host_log "supervisor exited ($(cut -d' ' -f1 "$NIMWAKE_RUN/state"))"
	return "$_result"
}

cmd_stop() {
	: >"$NIMWAKE_RUN/stop"
	_waited=0
	# daemon이 아직 기동 중일 수 있으므로 끝날 때까지 TERM을 다시 보낸다.
	while supervisor_pid >/dev/null || [ -n "$(daemon_pid)" ]; do
		if [ "$_waited" -ge "$NIMWAKE_STOP_TIMEOUT" ]; then
			# SIGTERM에 반응하지 않는 daemon은 래퍼를 잃은 고아일 수 있다 — application까지 정리한다
			echo "nimwake-host: still running after ${NIMWAKE_STOP_TIMEOUT}s — killing nimwaked and its applications" >&2
			reap_orphan_daemon
			break
		fi
		daemon_signal TERM
		sleep 1
		_waited=$((_waited + 1))
	done
	# supervisor 없이 떠 있던 daemon을 내린 경우에도 상태를 남긴다
	if ! supervisor_pid >/dev/null && ! grep -q '^STOPPED' "$NIMWAKE_RUN/state" 2>/dev/null; then
		set_state STOPPED "stopped by nimwake-host stop"
	fi
	rm -f "$NIMWAKE_RUN/stop"
	echo "nimwake-host: stopped after ${_waited}s"
}

cmd_status() {
	if [ -f "$NIMWAKE_RUN/state" ]; then
		echo "state       $(cat "$NIMWAKE_RUN/state")"
	else
		echo "state       (never started)"
	fi
	if _pid="$(supervisor_pid)"; then
		echo "supervisor  running (pid $_pid)"
	else
		echo "supervisor  not running"
	fi
	# 마지막으로 종료 기록 없이 사라진 때 — 재부팅이면 정상, killed가 잦으면 Android 보호 설정을 본다
	if [ -f "$NIMWAKE_RUN/last-unclean" ]; then
		echo "last-lost   $(cat "$NIMWAKE_RUN/last-unclean")"
	fi
	_daemon="$(daemon_pid)"
	if [ -n "$_daemon" ]; then
		echo "nimwaked    running (pid $_daemon)"
	else
		echo "nimwaked    not running"
	fi
	if health_probe; then
		echo "health      OK (404)"
	else
		echo "health      FAIL"
	fi
	# supervisor가 마지막으로 바뀐 상태를 남긴다 ("STATE 바뀐시각 이유"). 지금 값은 supervisor가 30초마다 갱신한다
	if [ -f "$NIMWAKE_RUN/network" ]; then
		read -r _net_state _net_day _net_time _net_why <"$NIMWAKE_RUN/network"
		echo "network     $_net_state since $_net_day $_net_time — $_net_why"
	else
		echo "network     unknown (supervisor has not checked yet)"
	fi
	# ingress: 감시 상태 + provider의 health (연결 여부, 공개 URL을 알면 그것도)
	if ingress_enabled; then
		_ing="$(cut -d' ' -f1 "$NIMWAKE_RUN/ingress" 2>/dev/null || echo unknown)"
		if [ -x "$NIMWAKE_INGRESS_DIR/$NIMWAKE_INGRESS/health" ] && _health="$(ingress_call health 2>/dev/null)"; then
			echo "ingress     $NIMWAKE_INGRESS $_ing — $_health"
		else
			echo "ingress     $NIMWAKE_INGRESS $_ing — ${_health:-not connected}"
		fi
	else
		echo "ingress     none (NIMWAKE_INGRESS is empty — LAN only)"
	fi
	_free="$(storage_free_mb)"
	if [ -z "$_free" ]; then
		echo "storage     unknown"
	elif [ "$_free" -lt "$NIMWAKE_MIN_FREE_MB" ]; then
		echo "storage     LOW ${_free}MB free (< ${NIMWAKE_MIN_FREE_MB}MB)"
	else
		echo "storage     ok ${_free}MB free"
	fi
	# supervisor가 정리 작업 주기마다 남긴 것 — "LEVEL PCT PLUGGED STATUS TEMP 날짜 시각"
	if [ -f "$NIMWAKE_RUN/battery" ]; then
		read -r _b_level _b_pct _b_plugged _b_status _b_temp _b_day _b_time <"$NIMWAKE_RUN/battery"
		echo "battery     $_b_level ${_b_pct}% $_b_plugged $_b_status ${_b_temp}°C (checked $_b_day $_b_time)"
	elif [ "$NIMWAKE_BATTERY_WATCH" = 1 ]; then
		echo "battery     not checked yet (every ${NIMWAKE_HOUSEKEEPING_INTERVAL}s while RUNNING)"
	fi
}

cmd_logs() {
	_lines="${1:-40}"
	echo "== supervisor.log"
	tail -n "$_lines" "$NIMWAKE_LOGS/supervisor.log" 2>/dev/null
	echo "== nimwaked.log"
	tail -n "$_lines" "$NIMWAKE_LOGS/nimwaked.log" 2>/dev/null
}

case "${1:-}" in
start) cmd_start ;;
stop) cmd_stop ;;
status) cmd_status ;;
logs) shift; cmd_logs "$@" ;;
__supervise) cmd_supervise ;;
*)
	echo "usage: nimwake-host start | stop | status | logs [N]" >&2
	exit 2
	;;
esac
