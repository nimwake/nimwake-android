#!/data/data/com.termux/files/usr/bin/sh
# Termux:Boot 진입점 — 재부팅 후 supervisor를 띄우고 READY까지 기다린다. (A3, PRD §10)
# make deploy가 ~/.termux/boot/ 에 설치한다. Termux:Boot는 00-sshd와 거의 동시에 이것을 시작한다.
#
# 단계마다 시각을 ~/.nimwake-host/logs/boot.log에 남기고, 시작 줄에 부팅 시각(`uptime -s`)을 적는다.
# "실행이 안 됐는지, 늦게 됐는지"를 구분하지 못하면 원인을 좁힐 수 없다. (validation/01 A3 사전 확인)
# Android는 앱에서 /proc/uptime을 읽지 못하게 막는다. `uptime -s`는 sysinfo()를 써서 동작한다.
#
# nimwaked는 직접 띄우지 않는다. supervisor(nimwake-host)가 띄우고 죽으면 재기동한다. (A2)
# READY = supervisor가 RUNNING을 기록했다. RUNNING은 health 404를 확인한 뒤에만 기록된다.
#   NIMWAKE_READY_TIMEOUT  RUNNING을 기다릴 초 (기본 90)
#   NIMWAKE_MIN_FREE_MB    이보다 여유 공간이 적으면 경고 (기본 1024). 기동은 막지 않는다
set -u

host="$HOME/.nimwake-host"
logs="$host/logs"
run="$host/run"
nimwake_host="$host/bin/nimwake-host"
ready_timeout="${NIMWAKE_READY_TIMEOUT:-90}"
min_free_mb="${NIMWAKE_MIN_FREE_MB:-1024}"

mkdir -p "$logs" "$run"

stamp() {
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$logs/boot.log"
}

stamp "boot: start (booted at $(uptime -s 2>/dev/null || echo unknown))"

termux-wake-lock
stamp "wake-lock: requested"

free_kb="$(df -Pk "$HOME" | awk 'NR == 2 { print $4 }')"
free_mb=$((free_kb / 1024))
if [ "$free_mb" -lt "$min_free_mb" ]; then
	stamp "storage: WARN ${free_mb}MB free (< ${min_free_mb}MB)"
else
	stamp "storage: ok ${free_mb}MB free"
fi

if [ ! -x "$nimwake_host" ]; then
	stamp "nimwake-host: not installed — make deploy"
	exit 1
fi

started="$("$nimwake_host" start 2>&1)"
case "$started" in
*"already running"*)
	stamp "nimwaked: already running, skip ($started)"
	exit 0
	;;
esac
stamp "supervisor: $started"

waited=0
state=""
while [ "$waited" -lt "$ready_timeout" ]; do
	state="$(cut -d' ' -f1 "$run/state" 2>/dev/null)"
	case "$state" in
	RUNNING)
		stamp "ready: health 404 after ${waited}s (supervisor RUNNING)"
		exit 0
		;;
	UNHEALTHY)
		stamp "nimwaked: UNHEALTHY — $(cut -d' ' -f4- "$run/state")"
		exit 1
		;;
	esac
	sleep 1
	waited=$((waited + 1))
done

stamp "ready: TIMEOUT after ${ready_timeout}s (state ${state:-none})"
exit 1
