#!/data/data/com.termux/files/usr/bin/sh
# Termux:Boot 진입점 — 재부팅 후 개발 머신이 손대지 않고 접속할 수 있게 sshd를 먼저 띄운다.
# 10-nimwake보다 먼저(00) 돈다. nimwaked 기동이 실패해도 원격으로 들어가 원인을 볼 수 있어야 한다.
# make deploy가 ~/.termux/boot/ 에 설치한다.

mkdir -p "$HOME/.nimwake-host/logs"
termux-wake-lock
sshd
printf '%s sshd: started (booted at %s)\n' "$(date '+%Y-%m-%d %H:%M:%S')" \
	"$(uptime -s 2>/dev/null || echo unknown)" >>"$HOME/.nimwake-host/logs/boot.log"
