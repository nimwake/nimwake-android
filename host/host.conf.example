# ~/.nimwake-host/host.conf — nimwake-host 설정 (KEY=value, shell이 source한다)
# 없는 값은 host/lib/config.sh의 기본값을 쓴다. make deploy는 이 파일이 있으면 덮지 않는다.

# LAN에서 접근하려면 연다. 비우면 Core 기본값 127.0.0.1:8080 (Core PRD §74 — 노출은 opt-in)
#NIMWAKE_LISTEN=0.0.0.0:8080

# daemon과 앱을 proot-distro --isolated로 띄운다 (기본 1). 0이면 앱이 Termux의 SSH 키 · 부팅 스크립트를
# 읽고 쓴다 — ingress로 인터넷에 열 때는 끄지 않는다 (Phase 2 04 T1)
#NIMWAKE_ISOLATED=1

# 가용 메모리(MB)가 이보다 적으면 Core가 app을 깨우지 않고(503) 유휴 app을 내린다 (Core PRD §78 · §80, #42).
# 비우면 넘기지 않는다(Core 기본값 0 = 꺼짐). Core v0.1.0-rc4 이상에서만 — 그 전 binary는 설정 오류(78)로 멈춘다.
# 값은 이 기기의 MemAvailable 분포로 정한다: make soak-report의 "memory available"
#NIMWAKE_MIN_FREE_MEMORY_MB=512

# health probe 간격과, 연속 실패 몇 번에 daemon을 내리고 재기동할지
#NIMWAKE_HEALTH_INTERVAL=30
#NIMWAKE_HEALTH_FAILURES=3

# 재기동 상한: window(초) 안에서 이 횟수에 닿으면 crash loop → UNHEALTHY (PRD §23–§24)
#NIMWAKE_MAX_RESTARTS=5
#NIMWAKE_RESTART_WINDOW=300

# 정리 작업(저장공간 검사 · 로그 순환) 간격(초)
#NIMWAKE_HOUSEKEEPING_INTERVAL=600

# 남은 저장공간 감시 (PRD §18, §44-6): MIN_FREE_MB 아래로 내려가면
# supervisor.log에 남기고 Android 알림을 띄운다 (상태가 바뀔 때 한 번). 알림 명령은 메시지를 $1로 받는다
#NIMWAKE_MIN_FREE_MB=1024
# 부족할 때 알리기 전에 순환된 이전 로그(.1–.3)를 지운다. 0이면 알리기만 한다
#NIMWAKE_STORAGE_CLEANUP=1
# 알림 명령: 메시지는 $1, 종류(storage · battery)는 $2
#NIMWAKE_NOTIFY='termux-notification --id "nimwake-${2:-alert}" --title Nimwake --content "$1"'
# 배터리 · 전원 감시 (host/lib/battery.sh): 잔량이 LOW(%) 아래 · 충전기 빠짐 · 꽂혀 있는데 줄어듦을 알린다.
# 읽기는 Termux:API(termux-battery-status) — 응답이 없으면 unknown, Termux:API 앱을 한 번 연다
#NIMWAKE_BATTERY_WATCH=1
#NIMWAKE_BATTERY_LOW=20

# 로그 순환 (PRD §20): supervisor.log · nimwaked.log · boot.log가 MAX_KB를 넘으면 .1 … .KEEP로 민다
#NIMWAKE_LOG_MAX_KB=20480
#NIMWAKE_LOG_KEEP=3

# 네트워크 상태 감시 (PRD §13–§14): ONLINE · DEGRADED · OFFLINE을 supervisor.log와 status에 남긴다.
# 끊겨도 Nimwake는 내리지 않는다. Android는 앱이 기본 경로 · 게이트웨이를 읽지 못하게 막으므로
# 게이트웨이 검사는 주소를 적어야 켜진다. 외부 검사는 기본으로 끈다 (외부 서비스에 기대지 않는다)
#NIMWAKE_NET_INTERVAL=30
#NIMWAKE_NET_GATEWAY=192.168.0.1
#NIMWAKE_NET_INTERNET_URL=http://connectivitycheck.gstatic.com/generate_204
# OFFLINE · DEGRADED에서 돌아올 때 돌릴 명령 — tunnel · VPN 재연결 등 (PRD §15). 출력은 supervisor.log로 간다
#NIMWAKE_NET_ON_RECOVER="$HOME/bin/reconnect-ingress"
#NIMWAKE_NET_HOOK_TIMEOUT=60

# ingress provider — 집 밖에서 닿게 한다 (Phase 2 03, host/ingress/<provider>). 비우면 LAN만.
# make ingress-enable INGRESS=cloudflare [MODE=quick] 가 적는다. 토큰은 make ingress-token < 파일 → secrets/
# provider가 supervisor 아래에서 돌고 끊기면 재기동된다. 네트워크가 돌아오면 다시 붙는다
# ingress를 켜고 LAN 전용 앱이 없으면 위의 NIMWAKE_LISTEN을 비워 gateway를 loopback으로 닫는다 (LAN 무인증 노출이 사라진다).
# LAN 전용 앱이 있으면 0.0.0.0을 유지한다 — 그 앱은 Cloudflare에 이름을 등록하지 않는 것으로만 막힌다 (Phase 2 04)
#NIMWAKE_INGRESS=cloudflare
# cloudflare: token(실사용, 대시보드 Public Hostname → http://localhost:8080) | quick(trycloudflare.com, 시험)
#NIMWAKE_INGRESS_CF_MODE=token
# quick 모드에서 Host로 보낼 이름 — 비우면 manifest의 첫 host
#NIMWAKE_INGRESS_CF_QUICK_HOST=blog.local
#NIMWAKE_INGRESS_CF_METRICS=127.0.0.1:20241
