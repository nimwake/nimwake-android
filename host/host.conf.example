# ~/.nimwake-host/host.conf — nimwake-host 설정 (KEY=value, shell이 source한다)
# 없는 값은 host/lib/config.sh의 기본값을 쓴다. make deploy는 이 파일이 있으면 덮지 않는다.

# LAN에서 접근하려면 연다. 비우면 Core 기본값 127.0.0.1:8080 (Core PRD §74 — 노출은 opt-in)
#NIMWAKE_LISTEN=0.0.0.0:8080

# health probe 간격과, 연속 실패 몇 번에 daemon을 내리고 재기동할지
#NIMWAKE_HEALTH_INTERVAL=30
#NIMWAKE_HEALTH_FAILURES=3

# 재기동 상한: window(초) 안에서 이 횟수에 닿으면 crash loop → UNHEALTHY (PRD §23–§24)
#NIMWAKE_MAX_RESTARTS=5
#NIMWAKE_RESTART_WINDOW=300

# 정리 작업(저장공간 검사 · 로그 순환) 간격(초)
#NIMWAKE_HOUSEKEEPING_INTERVAL=600

# 남은 저장공간 감시 (PRD §18, §44-6): MIN_FREE_MB 아래로 내려가면
# supervisor.log에 남기고 Android 알림을 띄운다 (상태가 바뀔 때 한 번). 알림 명령은 메시지를 $1로 받는다
#NIMWAKE_MIN_FREE_MB=1024
# 부족할 때 알리기 전에 순환된 이전 로그(.1–.3)를 지운다. 0이면 알리기만 한다
#NIMWAKE_STORAGE_CLEANUP=1
#NIMWAKE_NOTIFY='termux-notification --id nimwake-storage --title Nimwake --content "$1"'

# 로그 순환 (PRD §20): supervisor.log · nimwaked.log · boot.log가 MAX_KB를 넘으면 .1 … .KEEP로 민다
#NIMWAKE_LOG_MAX_KB=20480
#NIMWAKE_LOG_KEEP=3

# 네트워크 상태 감시 (PRD §13–§14): ONLINE · DEGRADED · OFFLINE을 supervisor.log와 status에 남긴다.
# 끊겨도 Nimwake는 내리지 않는다. Android는 앱이 기본 경로 · 게이트웨이를 읽지 못하게 막으므로
# 게이트웨이 검사는 주소를 적어야 켜진다. 외부 검사는 기본으로 끈다 (외부 서비스에 기대지 않는다)
#NIMWAKE_NET_INTERVAL=30
#NIMWAKE_NET_GATEWAY=192.168.0.1
#NIMWAKE_NET_INTERNET_URL=http://connectivitycheck.gstatic.com/generate_204
