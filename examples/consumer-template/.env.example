# cp .env.example .env — .env는 커밋하지 않는다 (.gitignore)

# 폰 — ~/.ssh/config의 Host 이름 (nimwake-android make install이 키 로그인을 만든다)
NIMWAKE_DEVICE=nimwake-phone

# Cloudflare Tunnel 토큰을 담은 파일의 경로. 토큰 자체를 여기 적지 않는다.
# 파일은 레포 밖에, 권한 600으로: chmod 600 ~/.secrets/cloudflare-tunnel.token
CLOUDFLARE_TOKEN_FILE=/home/me/.secrets/cloudflare-tunnel.token
