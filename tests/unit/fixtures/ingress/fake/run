#!/bin/sh
# 가짜 ingress provider의 run — 받은 계약 환경을 남기고 FAKE_DIR/ingress-mode대로 행동한다
#   (없음) 계속 돈다 · exit-N  N으로 끝난다
echo "$$" >>"$FAKE_DIR/ingress-runs"
printf "gateway=%s hosts=%s secrets=%s\n" "$NIMWAKE_GATEWAY" "$NIMWAKE_INGRESS_HOSTS" "$NIMWAKE_SECRETS" >"$FAKE_DIR/ingress-env"
mode="$(cat "$FAKE_DIR/ingress-mode" 2>/dev/null || true)"
case "$mode" in
exit-*) exit "${mode#exit-}" ;;
esac
exec sleep 300
